# Copy to .env and fill in. .env is ignored by git; never paste the key into a chat or a commit.
#
# From the AgentTrust Console (https://console.agent-trust.tech): Agents > your agent > Connect agent.
AGENTRUST_GATEWAY_URL=https://console.agent-trust.tech
AGENTRUST_KEY=at_live_replace_me
AGENTRUST_AGENT_ID=refund-bot

# What to do when the gateway cannot be reached: "closed" refuses the action, "open" runs it unchecked.
AGENTRUST_FAILURE_MODE=closed
